# Copy to .env and fill in. .env, cms.env and server.env are not committed.
#
# cms.env has the CMS settings of src/web/.env.example, without DATABASE_URL,
# REDIS_URL, STORAGE_DIR, STORAGE_DIR_HOST and CMS_PORT: compose.yml sets
# those. server.env is optional and has the NBN_* limits of
# src/server/.env.example.

# Storage directory on the host. The CMS writes it; SPUNServer reads its
# public subdirectory. Make STORAGE_DIR_HOST/public, owned by uid 1000, before
# the first start: otherwise Docker makes it as root, and the CMS cannot write it.
STORAGE_DIR_HOST=/path/to/storage

# Data directories on the host. Use a local disk, not NFS.
MARIADB_DATA_HOST=/path/to/mariadb
REDIS_DATA_HOST=/path/to/redis

# The database and its account, made on the first start of an empty
# MARIADB_DATA_HOST. Generate the passwords with: openssl rand -hex 24
MARIADB_DATABASE=spun
MARIADB_USER=spun
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=

# Optional. Host address and port of the CMS, for the reverse proxy; the
# default is 127.0.0.1:48180. Do not publish it on a public address.
# CMS_PORT=127.0.0.1:48180

# Optional. Host port of SPUNServer; the default is 48128, which the .spun
# client has compiled in.
# SPUN_PORT=48128
