{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "..",
    "outDir": "build",
    "sourceMap": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    // The vendored NBNtools engine imports pino. tsc looks for it from
    //    ../vendor, where nothing is installed, so point it at ours.
    "paths": { "pino": ["./node_modules/pino/pino.d.ts"] }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
