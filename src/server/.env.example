# Copy to .env and fill in. .env is not committed.

# MariaDB with the CMS tables, with the same account as the CMS. SPUNServer
# reads them, and writes only the download count (apps.downloads).
DATABASE_URL=mysql://USER:PASSWORD@DB_HOST:3306/DATABASE

# The public subdirectory of the CMS storage directory on the host
# (STORAGE_DIR_HOST/public), mounted read-only at /data.
DATA_DIR_HOST=/path/to/storage/public

# Optional connection limits of the NBN engine (src/vendor/NBNtools/server).
# NBN_IDLE: milliseconds a connection may be silent before the server closes
# it, without a message (default 600000, 10 minutes). A Next answers each block
# within a second, but .spun keeps its connection while its user reads a page
# or while it unzips, and its ESP8266 connects again by itself after a close.
# NBN_MAXCONNS: connections open at once (default 512). NBN_MAXPERIP:
# connections from one address (default 16, for several Nexts behind one router).
# NBN_IDLE=600000
# NBN_MAXCONNS=512
# NBN_MAXPERIP=16

# Optional. Host port for docker-compose.yml; the default is 48128.
# SPUN_PORT=48128

# Optional. The env file docker-compose.yml gives the container; the default
# is .env. The e2e SPUNServer of make e2e (src/web) uses .env.e2e: a copy of
# this file with the e2e database, DATA_DIR_HOST=<e2e storage>/public,
# SPUN_PORT=48129 and SPUN_ENV_FILE=.env.e2e.
# SPUN_ENV_FILE=.env

# Optional. Usernames for the server tests (make test); each must be a valid
# CMS username: 1-16 of A-Z a-z 0-9 _ -.
# SPUN_TEST_PUBLISHER=TestPublisher
# SPUN_TEST_OTHER_PUBLISHER=OtherPublisher
