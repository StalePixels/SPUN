# .spun get of dir001 again, over an older DIRTEST.TXT and C:/dot/SPUNDIR.
# y installs it again; C at the first Overwrite question cancels. The first
# pass of unzip (unzip/unzip.c) asks before anything is written, so the app
# directory and C:/dot stay as they were, and so does spun.cat. The error ends
# .spun, so ON ERROR keeps the autoexec running. Its handler prints SPUNERR
# with the error code and the line of .spun (30), which shows that .spun ended
# with an error and not by returning, then waits in a loop. BASIC prints no
# report for a trapped error, so the message is checked in
# spun-dir-update.scn.in, where .spun prints it itself. NextZXOS fetches $0000
# once when a handler catches the error of a dot command, with BASIC at the
# line of that command, and the harness logs it as a "reset" line, so this
# scenario has no noreset; mame-dir.sh looks for a "machine reset" line in
# mame.log instead.
put @SPUN@ /dot/SPUN
put @CAT@ /sys/spun.cat
put @OLD@ /apps/spundir/deep/DIRTEST.TXT
put @OLD@ /dot/SPUNDIR
autostart ON ERROR ERROR TO e,l:PRINT "SPUNERR ";e;" ";l:FOR i=0 TO 1 STEP 0: NEXT i
autostart .spun get dir001
autostart FOR i=0 TO 1 STEP 0: NEXT i
seconds 35
key 16 y
key 20 c
snap 15 19 23 34
screen 34 Installed. Install again?
screen 34 Overwrite C:/apps/spundir/deep/
screen 34 SPUNERR 255 30
