# .spun get self01, whose zip holds spun.dot and README.txt, as SPUN's own
# release zip does. Its target C:/dot/spun is the running .spun. y takes the
# suggested /apps/wifi/spun; o overwrites C:/dot/spun. .spun must replace its
# own file and finish; CLS clears the screen, so the next output does not stop
# at "scroll?"; then the new /dot/spun runs info against the test server.
# mame-self.sh checks C:/dot/spun, the app directory and spun.cat after the run.
put @SPUN@ /dot/SPUN
autostart .spun get self01
autostart CLS
autostart .spun -s @HOST@ -p @PORT@ info self01
autostart PRINT "SPUNSELFDONE"
autostart FOR i=0 TO 1 STEP 0: NEXT i
seconds 45
noreset 7.5
key 16 y
key 22 o
snap 15 21 25 30 44
screen 44 Self Test
screen 44 by @OWNER@
screen 44 SPUNSELFDONE
