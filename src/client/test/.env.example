# Copy to .env and fill in. .env is not committed.

# A published app on the test server, and text that finds it with FIND
# (FIND matches the app's title and description). The e2e setup in src/web
# publishes the app E2E_TEST_APP of src/web/.env.e2e, titled "Next Test".
SPUN_TEST_APP=abc123
SPUN_TEST_FIND="Next Test"

# The SPUNServer that build.sh puts into the test binaries as their default:
# the e2e SPUNServer (src/server/.env.e2e). In MAME, 127.0.0.1 is this machine.
SPUN_TEST_SERVER=127.0.0.1
SPUN_TEST_PORT=48129

# Optional. Commands that mame-get.sh runs to start the server before the
# scenarios and to stop it after them, also after a failure.
# SPUN_TEST_SERVER_UP="make -C /path/to/SPUN/src/server e2e-up"
# SPUN_TEST_SERVER_DOWN="make -C /path/to/SPUN/src/server e2e-down"

# z88dk 2.4 for the Next build, the esp-harness folder (run.py), and the MAME binary.
Z88DK=/path/to/z88dk
ESP_HARNESS=/path/to/esp-harness
MAME=mame

# Optional. hdfmonkey, to print /sys/spun.cat from the run's SD image.
# HDFMONKEY=/path/to/hdfmonkey
