# Copy to .env and fill in. .env is not committed.

# A published app on the test server, and text that finds it with FIND
# (FIND matches the app's title and description).
SPUN_TEST_APP=abc123
SPUN_TEST_FIND="Test App"

# The SPUNServer that build.sh puts into the test binaries as their default.
# In MAME, 127.0.0.1 is this machine.
SPUN_TEST_SERVER=127.0.0.1
SPUN_TEST_PORT=48128

# z88dk 2.4 for the Next build, the esp-harness folder (run.py), and the MAME binary.
Z88DK=/path/to/z88dk
ESP_HARNESS=/path/to/esp-harness
MAME=mame

# Optional. hdfmonkey, to print /sys/spun.cat from the run's SD image.
# HDFMONKEY=/path/to/hdfmonkey
