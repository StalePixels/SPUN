# Copy to .env and fill in. .env is not committed.

# MySQL on the LAN: CMS tables and Auth.js sessions.
DATABASE_URL=mysql://USER:PASSWORD@DB_HOST:3306/DATABASE

# Redis on the LAN: the claim set of each user.
REDIS_URL=redis://REDIS_HOST:6379/0

# Auth.js. Generate the secret with: openssl rand -base64 33
AUTH_SECRET=
# The URL the browser uses for the CMS. http:// gives non-secure cookies.
AUTH_URL=http://CMS_HOST:48180

# byob-oidc client, as registered in the byob-oidc clients table.
AUTH_NBN_ISSUER=https://id.nextbestnetwork.com/
AUTH_NBN_ID=spun-cms
AUTH_NBN_SECRET=

# Storage directory inside the container. The CMS uses three subdirectories:
# public (uploads, at public/<username>/), bin (the recycle bin) and assets.
STORAGE_DIR=/path/to/storage
# Storage directory on the host, mounted at STORAGE_DIR by compose.yml.
STORAGE_DIR_HOST=/path/to/storage

# Host port for compose.yml.
CMS_PORT=48180
