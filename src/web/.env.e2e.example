# Settings for the browser tests (make e2e). Copy to .env.e2e and fill in.
# .env.e2e is not committed.

# make e2e resets this dataset, starts the e2e CMS (compose.yml with
# .env.e2e-cms) and the e2e SPUNServer (src/server, with its .env.e2e), then
# runs the tests. Never point these at data you keep: the reset drops every
# table and empties the storage directory. It refuses a database whose name
# does not end in _e2e, or a storage directory whose name does not end in -e2e.

# The e2e CMS. Log in works only on the host name in the CMS AUTH_URL.
E2E_BASE_URL=http://CMS_HOST:PORT
# The e2e CMS database and storage directory (STORAGE_DIR_HOST in .env.e2e-cms).
E2E_DATABASE_URL=mysql://USER:PASSWORD@DB_HOST:3306/spun_e2e
E2E_STORAGE_DIR=/path/to/data-e2e

# The id (6 of 0-9 a-z) of the app the setup publishes for the client after a
# reset. The MAME test of .spun gets it (SPUN_TEST_APP in src/client/test/.env).
E2E_TEST_APP=abc123

# Optional. The NBN:ID address the CMS sends the browser to for log in.
# E2E_NBN_ID_URL=https://id.nextbestnetwork.com/

# A user who is not an admin. The PIN mail for log in is read over IMAP (TLS).
E2E_CLIENT_EMAIL=client@example.com
E2E_CLIENT_PASSWORD=
E2E_CLIENT_USERNAME=
E2E_CLIENT_IMAP_HOST=
E2E_CLIENT_IMAP_PORT=993
E2E_CLIENT_IMAP_USER=client@example.com
E2E_CLIENT_IMAP_PASSWORD=

# A user who is an admin. On the empty database after a reset this account
# logs in first, and so becomes the admin.
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=
E2E_ADMIN_USERNAME=
E2E_ADMIN_IMAP_HOST=
E2E_ADMIN_IMAP_PORT=993
E2E_ADMIN_IMAP_USER=admin@example.com
E2E_ADMIN_IMAP_PASSWORD=
